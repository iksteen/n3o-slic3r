# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

__pycache__

# cmake output for the FFI .so (driven by crates/slic3r-ffi/build.rs)
/build/
# cargo workspace target
/target/

# makepkg artifacts. PKGBUILD lives at packaging/arch/, so $srcdir,
# $pkgdir, and the output .pkg.tar.zst all land there.
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.pkg.tar.zst
/packaging/arch/*.pkg.tar.zst.sig

# flatpak-builder writes its cache to the CWD by default; the scripts
# pin it under packaging/flatpak/ via --state-dir, but guard the root in
# case flatpak-builder is ever run here directly.
/.flatpak-builder/

# local environment overrides loaded by `npm run tauri dev` via dotenv-cli
.env
.env.local
.env.*.local

# Slice / driver scratch output that wanders into the repo root.
# Large binary files; never commit. Anchored to `/` so vendored
# fixtures under `examples/` and `external/` aren't matched.
/*.gcode.3mf
/*.3mf

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude
bugs.txt
