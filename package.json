{
  "name": "n3o-slic3r",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "cross-env N3O_SLIC3R_RESOURCES_ROOT=./resources dotenv -- tauri",
    "publish:flatpak": "dotenv ./packaging/flatpak/publish.sh",
    "publish:arch": "dotenv ./packaging/arch/publish.sh",
    "publish:windows": "dotenv ./packaging/windows-cross/publish.sh",
    "publish:mac-arm64": "dotenv ./packaging/macos-cross/publish.sh arm64",
    "publish:mac-x86_64": "dotenv ./packaging/macos-cross/publish.sh x86_64",
    "publish:all": "npm run publish:flatpak && npm run publish:arch && npm run publish:windows && npm run publish:mac-arm64 && npm run publish:mac-x86_64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^2.1.0"
  }
}
