{
  "name": "n3o-slic3r",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "demo:build": "vite build --mode demo && python3 demo/inline.py",
    "test": "vitest run",
    "tauri": "cross-env N3O_SLIC3R_RESOURCES_ROOT=./resources dotenv -- tauri",
    "build:arch": "dotenv ./packaging/arch/build.sh",
    "build:flatpak": "dotenv ./packaging/flatpak/build.sh",
    "build:windows": "dotenv ./packaging/windows-cross/build.sh",
    "build:mac-arm64": "dotenv ./packaging/macos-cross/build.sh arm64",
    "build:mac-x86_64": "dotenv ./packaging/macos-cross/build.sh x86_64",
    "build:all": "npm run build:flatpak && npm run build:arch && npm run build:windows && npm run build:mac-arm64 && npm run build:mac-x86_64",
    "clean": "./scripts/clean.sh",
    "clean:arch": "./packaging/arch/clean.sh",
    "clean:flatpak": "./packaging/flatpak/clean.sh",
    "clean:windows": "./packaging/windows-cross/clean.sh",
    "clean:mac": "./packaging/macos-cross/clean.sh",
    "clean:demo": "./packaging/demo/clean.sh",
    "publish:flatpak": "dotenv ./packaging/flatpak/publish.sh",
    "publish:arch": "dotenv ./packaging/arch/publish.sh",
    "publish:windows": "dotenv ./packaging/windows-cross/publish.sh",
    "publish:mac-arm64": "dotenv ./packaging/macos-cross/publish.sh arm64",
    "publish:mac-x86_64": "dotenv ./packaging/macos-cross/publish.sh x86_64",
    "publish:demo": "dotenv ./packaging/demo/publish.sh",
    "publish:all": "npm run publish:flatpak && npm run publish:arch && npm run publish:windows && npm run publish:mac-arm64 && npm run publish:mac-x86_64 && npm run publish:demo"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
