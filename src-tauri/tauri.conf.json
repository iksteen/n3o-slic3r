{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "n3o-slic3r",
  "version": "0.1.0",
  "identifier": "org.thegraveyard.n3o-slic3r",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "n3o-slic3r",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/profiles": "profiles",
      "../resources/plugins": "plugins",
      "../resources/engine": "engine"
    }
  }
}
