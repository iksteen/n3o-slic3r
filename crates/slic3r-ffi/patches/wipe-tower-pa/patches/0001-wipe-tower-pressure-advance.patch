diff --git a/src/libslic3r/PrintConfig.cpp b/src/libslic3r/PrintConfig.cpp
index 982953afa5..18c4f86651 100644
--- a/src/libslic3r/PrintConfig.cpp
+++ b/src/libslic3r/PrintConfig.cpp
@@ -5992,6 +5992,23 @@ void PrintConfigDef::init_fff_params()
     def->mode = comAdvanced;
     def->set_default_value(new ConfigOptionBool(true));
 
+    // Snapmaker U1: prime-tower ramming pressure advance. When enabled, ramming
+    // sets a fixed pressure advance (ramming_pressure_advance_value) instead of
+    // zeroing it — avoids blobbing from unrelieved nozzle pressure during priming.
+    def = this->add("enable_change_pressure_when_wiping", coBool);
+    def->label = L("Change pressure advance when wiping");
+    def->tooltip = L("Set a fixed pressure advance during prime-tower ramming "
+                     "(ramming_pressure_advance_value) instead of disabling it.");
+    def->mode = comDevelop;
+    def->set_default_value(new ConfigOptionBool(false));
+
+    def = this->add("ramming_pressure_advance_value", coFloat);
+    def->label = L("Ramming pressure advance value");
+    def->tooltip = L("Pressure advance applied during prime-tower ramming when "
+                     "\"Change pressure advance when wiping\" is enabled.");
+    def->mode = comDevelop;
+    def->set_default_value(new ConfigOptionFloat(0.0));
+
     def = this->add("tool_change_on_wipe_tower", coBool);
     def->label = L("Tool change on wipe tower");
     def->tooltip = L("Force the toolhead to travel to the wipe tower before issuing the tool change command (Tx). "
