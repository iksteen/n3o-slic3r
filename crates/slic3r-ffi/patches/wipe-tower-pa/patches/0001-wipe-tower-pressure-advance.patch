wipe-tower-pa: static pressure advance during prime-tower ramming (Snapmaker U1)

Adds two GCodeConfig options — enable_change_pressure_when_wiping (Bool) and
ramming_pressure_advance_value (Float) — and a WipeTower2 emission variant
disable_linear_advance_value(). When enabled, prime-tower ramming sets
SET_PRESSURE_ADVANCE=<value> instead of upstream's 0, so the nozzle isn't left
unpressurized (which blobs the prime). Ports Snapmaker's own Orca fork change.
Inert unless enable_change_pressure_when_wiping is set (default false).

diff --git a/src/libslic3r/GCode/WipeTower2.cpp b/src/libslic3r/GCode/WipeTower2.cpp
index c68a74f8b3..4be141922a 100644
--- a/src/libslic3r/GCode/WipeTower2.cpp
+++ b/src/libslic3r/GCode/WipeTower2.cpp
@@ -631,6 +631,19 @@ public:
         return *this;
     }
 
+    // Snapmaker U1: like disable_linear_advance() but set a specific pressure
+    // advance during ramming instead of zeroing it — zero leaves the nozzle
+    // pressurized and blobs the prime. Used when enable_change_pressure_when_wiping.
+    WipeTowerWriter2&            disable_linear_advance_value(float value) {
+        if (m_gcode_flavor == gcfRepRapSprinter || m_gcode_flavor == gcfRepRapFirmware)
+            m_gcode += (std::string("M572 D") + std::to_string(m_current_tool) + " S" + std::to_string(value) + "\n");
+        else if (m_gcode_flavor == gcfKlipper)
+            m_gcode += "SET_PRESSURE_ADVANCE ADVANCE=" + Slic3r::float_to_string_decimal_point(value, 4) + "\n";
+        else
+            m_gcode += "M900 K" + std::to_string(value) + "\n";
+        return *this;
+    }
+
     WipeTowerWriter2& switch_filament_monitoring(bool enable) {
         m_gcode += std::string("G4 S0\n") + "M591 " + (enable ? "R" : "S0") + "\n";
         return *this;
@@ -1248,6 +1261,8 @@ WipeTower::ToolChangeResult WipeTower2::construct_tcr(WipeTowerWriter2& writer,
 WipeTower2::WipeTower2(const PrintConfig& config, const PrintRegionConfig& default_region_config,int plate_idx, Vec3d plate_origin, const std::vector<std::vector<float>>& wiping_matrix, size_t initial_tool) :
     m_semm(config.single_extruder_multi_material.value),
     m_enable_filament_ramming(config.enable_filament_ramming.value),
+    m_change_pressure(config.enable_change_pressure_when_wiping.value),
+    m_change_pressure_value(float(config.ramming_pressure_advance_value.value)),
     m_wipe_tower_filament(config.wipe_tower_filament.value),
     m_wipe_tower_pos(config.wipe_tower_x.get_at(plate_idx), config.wipe_tower_y.get_at(plate_idx)),
     m_wipe_tower_width(float(config.prime_tower_width)),
@@ -1659,8 +1674,12 @@ void WipeTower2::toolchange_Unload(
 
     if (do_ramming) {
         writer.travel(ramming_start_pos); // move to starting position
-        if (! m_is_mk4mmu3)
-            writer.disable_linear_advance();
+        if (! m_is_mk4mmu3) {
+            if (m_change_pressure)
+                writer.disable_linear_advance_value(m_change_pressure_value); // Snapmaker U1
+            else
+                writer.disable_linear_advance();
+        }
         if (cold_ramming)
             writer.set_extruder_temp(old_temperature - 20);
     }
@@ -1774,8 +1793,12 @@ void WipeTower2::toolchange_Unload(
 
         float speed_inc = (final_speed - initial_speed) / (2.f * number_of_cooling_moves - 1.f);
 
-        if (m_is_mk4mmu3)
-            writer.disable_linear_advance();
+        if (m_is_mk4mmu3) {
+            if (m_change_pressure)
+                writer.disable_linear_advance_value(m_change_pressure_value); // Snapmaker U1
+            else
+                writer.disable_linear_advance();
+        }
 
         writer.suppress_preview()
               .travel(writer.x(), writer.y() + y_step);
